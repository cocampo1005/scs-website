# Hostinger (Apache/LiteSpeed) rules for the single-page app.
# Deployed with the build; see docs/deployment.md before replacing the server copy.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files (assets, models, robots.txt, sitemap.xml) and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Known app routes are served by the app (keep in sync with src/App.jsx)
  RewriteRule ^(about|projects|contact|privacy|terms)/?$ /index.html [L]
</IfModule>

# Anything else is a real 404; the app renders its Not Found page for it
ErrorDocument 404 /index.html
